POSTGRES_PASSWORD=change-me
GITHUB_TOKEN=
MCPLAIN_JOBS_DIR=/absolute/path/to/mcplain/var/jobs
MCPLAIN_UID=1000
MCPLAIN_GID=1000
DOCKER_GID=1001
MCPLAIN_ATELIER_IMAGE=mcplain-atelier:dev
MCPLAIN_ATELIER_TIMEOUT=120
MCPLAIN_MAX_PARALLEL=2
MCPLAIN_DISPATCHER_ID=main
MCPLAIN_MAX_QUEUED=100
MCPLAIN_CORS_ORIGINS=http://localhost:3000
MCPLAIN_WEB_PORT=3000
# never put this key in GitHub
MCPLAIN_ANTHROPIC_API_KEY=
MCPLAIN_AI_MODEL=claude-sonnet-5-5
MCPLAIN_AI_EFFORT=low
# between_tools only exists on Claude Sonnet 5.5: change this value if you change the model
MCPLAIN_AI_THINKING=between_tools
MCPLAIN_AI_MAX_TOKENS=3500
MCPLAIN_AI_TRANSLATION_MAX_TOKENS=6000
MCPLAIN_AI_API_VERSION=2026-10-21
MCPLAIN_AI_TIMEOUT_S=60
MCPLAIN_AI_PRICE_INPUT_PER_MTOK=2
MCPLAIN_AI_PRICE_OUTPUT_PER_MTOK=10
MCPLAIN_AI_MONTHLY_BUDGET_USD=10
MCPLAIN_AI_DAILY_FUSE_USD=
# Accounts (session 9a). Run scripts/init-secrets.sh: it fills the empty secrets below with random values in .env.
# never put this in GitHub
BETTER_AUTH_SECRET=
# never put this in GitHub
MCPLAIN_ALTCHA_HMAC_KEY=
# never put this in GitHub
MCPLAIN_APP_DB_PASSWORD=
# never put this in GitHub
MCPLAIN_GUICHET_DB_PASSWORD=
# never put this in GitHub
MCPLAIN_FACTEUR_DB_PASSWORD=
# In development the mails go to Mailpit (profile dev, http://127.0.0.1:8025), without any password.
COMPOSE_PROFILES=dev
MCPLAIN_SMTP_HOST=mailpit
MCPLAIN_SMTP_PORT=1025
# never put this in GitHub
MCPLAIN_SMTP_USER=
# never put this in GitHub
MCPLAIN_SMTP_PASSWORD=
MCPLAIN_SMTP_FROM=MCPlain <no-reply@mcplain.localhost>
MCPLAIN_SMTP_STARTTLS=false
# never put this in GitHub
MCPLAIN_ADMIN_EMAIL=
MCPLAIN_MAILPIT_PORT=8025
MCPLAIN_TRUSTED_PROXY_HOPS=1
MCPLAIN_SIGNUPS_PER_IP_PER_DAY=30
MCPLAIN_ALTCHA_COST=2000
