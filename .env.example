POSTGRES_PASSWORD=change-me
GITHUB_TOKEN=
MCPLAIN_JOBS_DIR=/absolute/path/to/mcplain/var/jobs
MCPLAIN_UID=1000
MCPLAIN_GID=1000
DOCKER_GID=1001
MCPLAIN_ATELIER_IMAGE=mcplain-atelier:dev
MCPLAIN_ATELIER_TIMEOUT=120
MCPLAIN_MAX_PARALLEL=2
MCPLAIN_DISPATCHER_ID=main
MCPLAIN_MAX_QUEUED=100
MCPLAIN_CORS_ORIGINS=http://localhost:3000
MCPLAIN_WEB_PORT=3000
# never put this key in GitHub
MCPLAIN_ANTHROPIC_API_KEY=
MCPLAIN_AI_MODEL=claude-sonnet-5-5
MCPLAIN_AI_EFFORT=low
# between_tools only exists on Claude Sonnet 5.5: change this value if you change the model
MCPLAIN_AI_THINKING=between_tools
MCPLAIN_AI_MAX_TOKENS=3500
MCPLAIN_AI_TRANSLATION_MAX_TOKENS=6000
MCPLAIN_AI_API_VERSION=2026-10-21
MCPLAIN_AI_TIMEOUT_S=60
MCPLAIN_AI_PRICE_INPUT_PER_MTOK=2
MCPLAIN_AI_PRICE_OUTPUT_PER_MTOK=10
MCPLAIN_AI_MONTHLY_BUDGET_USD=10
MCPLAIN_AI_DAILY_FUSE_USD=
