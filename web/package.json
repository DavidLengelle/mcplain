{
  "name": "mcplain-web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "node scripts/copy-altcha-worker.mjs && next dev --hostname localhost",
    "build": "node scripts/copy-altcha-worker.mjs && next build",
    "start": "next start --hostname localhost",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:stack": "playwright test --config playwright.stack.config.ts"
  },
  "dependencies": {
    "altcha": "3.5.0",
    "better-auth": "1.7.15",
    "cn": "0.5.2",
    "next": "16.4.4",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@11.28.1"
}
